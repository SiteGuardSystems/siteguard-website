{
  "name": "siteguard-website",
  "private": true,
  "type": "module",
  "description": "siteguardsystems.com.au: multi-page static site built by build.mjs for Cloudflare Pages.",
  "scripts": {
    "build": "node build.mjs",
    "build:production": "node build.mjs --production",
    "sync-legal": "node scripts/sync-legal.mjs",
